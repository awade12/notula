# --- Recommended: Neon (free, pgvector included, no Docker) ---
# 1. https://neon.tech → New project → copy connection string
# 2. Paste below (use the pooled URL if Neon offers one)
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Optional: Docker (pgvector image, needs Docker Desktop) ---
DATABASE_URL=postgresql://notesapp:notesapp@localhost:5432/notesapp

# Plain Postgres without pgvector works for dev, but semantic/hybrid search needs pgvector.
# Migration 0008 adds embeddings; it is skipped if your host lacks the vector extension.

# Server (apps/server)
BETTER_AUTH_SECRET=dev-secret-change-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
PORT=3001

# Web (apps/web) — optional; leave unset to use same-origin /api via Vite proxy in dev
# VITE_API_URL=http://localhost:3001

# Hugeicons Pro — Universal License Key from https://hugeicons.com/account (required for `bun install`)
# HUGEICONS_LICENSE_KEY=
