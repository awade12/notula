FROM oven/bun:1.3.10 AS deps
WORKDIR /app

ARG HUGEICONS_LICENSE_KEY=""
ENV HUGEICONS_LICENSE_KEY=$HUGEICONS_LICENSE_KEY
ENV NODE_ENV=development

COPY package.json bun.lock bunfig.toml .npmrc ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY tooling/tsconfig tooling/tsconfig/

RUN bun install --frozen-lockfile

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/server/node_modules ./apps/server/node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/bun.lock ./bun.lock
COPY packages/shared packages/shared
COPY apps/server apps/server
COPY tooling tooling

RUN chmod +x apps/server/docker-entrypoint.sh apps/server/docker-migrate.sh

WORKDIR /app/apps/server
EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=10s --start-period=60s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:3001/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/app/apps/server/docker-entrypoint.sh"]
