# Coolify (recommended): create Docker Compose resource → Deploy.
# Coolify auto-generates SERVICE_* values from docker-compose.yaml:
#   SERVICE_FQDN_WEB_3000, SERVICE_FQDN_SERVER_3001
#   SERVICE_URL_WEB, SERVICE_URL_SERVER
#   SERVICE_PASSWORD_POSTGRES, SERVICE_REALBASE64_AUTH
# Compose passes PGHOST/PGUSER/PGPASSWORD/PGDATABASE; the server builds DATABASE_URL at startup.
# Only set HUGEICONS_LICENSE_KEY (and custom domains when you have them).

# --- Optional: custom domains (override Coolify auto-generated URLs) ---
# WEB_ORIGIN=https://notula.dev
# BETTER_AUTH_URL=https://api.notula.dev
# VITE_API_URL=https://api.notula.dev

# --- Optional: manual secrets (skip on Coolify — auto-generated) ---
# BETTER_AUTH_SECRET=change-me-min-32-characters-long-secret
# POSTGRES_PASSWORD=change-me-strong-password

POSTGRES_USER=notula
POSTGRES_DB=notula

# --- Build args ---
# HUGEICONS_LICENSE_KEY=your-key-from-hugeicons.com

# External Postgres (remove postgres service from compose if used):
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
