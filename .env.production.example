# Copy to .env for docker compose / Coolify environment variables.

# --- Domains (public URLs) ---
WEB_ORIGIN=https://notula.dev
BETTER_AUTH_URL=https://api.notula.dev
VITE_API_URL=https://api.notula.dev

# --- Auth ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-min-32-characters-long-secret

# --- Postgres (included in docker-compose.yaml) ---
POSTGRES_USER=notula
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=notula

# Internal compose URL (default). For Neon, set DATABASE_URL instead and remove postgres service.
# DATABASE_URL=postgresql://notula:change-me-strong-password@postgres:5432/notula

# External Postgres example (Neon):
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Build args (Coolify: set under Build → Build Arguments) ---
# HUGEICONS_LICENSE_KEY=your-key-from-hugeicons.com
