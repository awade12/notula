FROM oven/bun:1.3.10 AS deps
WORKDIR /app

ARG HUGEICONS_LICENSE_KEY=""
ENV HUGEICONS_LICENSE_KEY=$HUGEICONS_LICENSE_KEY
ENV NODE_ENV=development

COPY package.json bun.lock bunfig.toml .npmrc ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY tooling/tsconfig tooling/tsconfig/

RUN bun install --frozen-lockfile

FROM deps AS build
WORKDIR /app

ARG VITE_API_URL=""
ARG SERVICE_FQDN_SERVER_3001=""
ARG SERVICE_FQDN_SERVER=""
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV NODE_ENV=development
ENV VITE_API_URL=$VITE_API_URL
ENV SERVICE_FQDN_SERVER_3001=$SERVICE_FQDN_SERVER_3001
ENV SERVICE_FQDN_SERVER=$SERVICE_FQDN_SERVER

COPY packages/shared packages/shared
COPY apps/web apps/web
COPY tooling tooling

WORKDIR /app/apps/web
RUN chmod +x docker-build.sh
RUN ./docker-build.sh

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/apps/web/package.json ./apps/web/package.json
COPY --from=build /app/apps/web/dist ./apps/web/dist
COPY --from=build /app/apps/web/server.mjs ./apps/web/server.mjs

WORKDIR /app/apps/web
EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=10s --start-period=60s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.mjs"]
